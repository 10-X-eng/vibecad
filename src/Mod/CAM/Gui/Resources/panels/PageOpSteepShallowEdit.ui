   </rect>
  </property>
  <property name="windowTitle">
   <string notr="true">Form</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QFrame" name="toolOptions">
     <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
     <property name="frameShadow"><enum>QFrame::Raised</enum></property>
     <layout class="QGridLayout" name="gridLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="toolController_label">
        <property name="text"><string>Tool Controller</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="toolController">
        <property name="toolTip"><string>Tool controller that supplies the cutter geometry, feed and speed for this operation.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="coolantController_label">
        <property name="text"><string>Coolant</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="coolantController">
        <property name="toolTip"><string>Coolant mode emitted at the start of the operation.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="steepShallowOptions">
     <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
     <property name="frameShadow"><enum>QFrame::Raised</enum></property>
     <layout class="QGridLayout" name="gridLayout_2">
      <item row="0" column="0">
       <widget class="QLabel" name="cutMode_label">
        <property name="text"><string>Cut Mode</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cutMode">
        <property name="toolTip"><string>Climb: passes traverse in the canonical direction. Conventional: every pass traversal is reversed. Pick to match how the cutter should engage the material on your machine.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="slopeThreshold_label">
        <property name="text"><string>Slope Threshold</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="Gui::InputField" name="slopeThreshold">
        <property name="toolTip"><string>Slope angle (degrees) separating steep from shallow regions. Surfaces steeper than this get constant-Z contour passes (even scallops on walls); flatter surfaces get surface-following parallel passes (even scallops on floors). 45° is a good default.</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="stepOver_label">
        <property name="text"><string>Step Over</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="Gui::InputField" name="stepOver">
        <property name="toolTip"><string>Lateral spacing between surface-following passes in shallow regions (mm). Smaller values give a finer finish at the cost of cycle time. Vertical spacing of the constant-Z contours in steep regions is set by Step Down on the Depths page.</string></property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="boundaryOverlap_label">
        <property name="text"><string>Boundary Overlap</string></property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="Gui::InputField" name="boundaryOverlap">
        <property name="toolTip"><string>Distance the shallow passes extend past the steep/shallow boundary (mm) so the two strategies overlap instead of leaving an unmachined stripe where they meet.</string></property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="sampleInterval_label">
        <property name="text"><string>Sample Interval</string></property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="Gui::InputField" name="sampleInterval">
        <property name="toolTip"><string>Grid spacing of the drop-cutter surface sampling (mm). Smaller values follow the surface more accurately but compute more slowly.</string></property>
       </widget>
      </item>
      <item row="5" column="0" colspan="2">
       <widget class="QCheckBox" name="useRestMachining">
        <property name="text"><string>Rest Machining</string></property>
        <property name="toolTip"><string>Only cut material a previous, larger tool could not reach. Passes are restricted to regions the reference tool left uncut (inside corners and tight fillets).</string></property>
       </widget>
      </item>
      <item row="6" column="0">
       <widget class="QLabel" name="restReferenceToolDiameter_label">
        <property name="text"><string>Reference Tool Diameter</string></property>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="Gui::InputField" name="restReferenceToolDiameter">
        <property name="enabled"><bool>false</bool></property>
        <property name="toolTip"><string>Diameter of the previous (larger) tool used to identify leftover material for rest machining.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
